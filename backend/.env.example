# Server Configuration
PORT=8000

# production — real SMS OTP, strict CORS (CORS_ORIGINS required)
# staging/APK testing — use development + MOCK_OTP (see below)
NODE_ENV=production

# Database
# URI for your MongoDB instance (e.g., MongoDB Atlas or DigitalOcean Managed DB)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Security
# Secret key for signing JWT tokens (required in production)
JWT_SECRET=your_jwt_secret_key
# General /api rate limit per IP per 15 minutes (default 400; sized for mobile polling)
API_RATE_LIMIT_MAX=400

# Local dev / staging APK testing — allows OTP 1234 when NODE_ENV is not production
# Staging example: NODE_ENV=development, MOCK_OTP=true on https://hairone.duckdns.org
MOCK_OTP=true

# Production CORS (comma-separated origins, required when NODE_ENV=production)
# Not required for native Android/iOS apps (no Origin header); needed for web/admin
CORS_ORIGINS=https://yourapp.com,https://admin.yourapp.com

# Razorpay (online payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Webhook secret from Razorpay Dashboard → Webhooks
# Subscribe: payment.authorized, payment.captured, payment.failed,
# refund.created, refund.processed, refund.failed,
# payment.dispute.created|under_review|action_required|won|lost|closed
# Note: app refunds are wallet-only — do not Razorpay-refund wallet-credited amounts.
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# DigitalOcean Spaces (Object Storage)
# Endpoint for your Spaces region (e.g., https://blr1.digitaloceanspaces.com)
DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# AWS SDK region — must be us-east-1 for DigitalOcean Spaces (not the DO region slug)
DO_SPACES_REGION=us-east-1
# Access Key ID from DigitalOcean API settings
DO_SPACES_KEY=your_spaces_access_key
# Secret Access Key from DigitalOcean API settings
DO_SPACES_SECRET=your_spaces_secret_key
# Main bucket name for application uploads (images, etc.)
DO_SPACES_BUCKET=hairone-uploads

# Database Backups (Optional)
# If set, backups will be stored in this separate bucket.
# If not set, they will be stored in the main DO_SPACES_BUCKET.
DO_BACKUP_BUCKET=hairone-backups
# Delete Objects under backups/ older than this many days (default 14)
BACKUP_RETENTION_DAYS=14

# Logging
# Levels: debug | info | warn | error (default info)
LOG_LEVEL=info
# Format: json (production default) | pretty (local TTY default)
# LOG_FORMAT=json
